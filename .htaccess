
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose application configuration or source files.
    RewriteRule ^(?:\.env|composer\.(?:json|lock)|artisan|storage(?:/|$)|vendor(?:/|$)) - [F,L,NC]

    # Laravel's web root is public/. Keep the repository root out of the
    # document root when the hosting panel cannot be changed immediately.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
